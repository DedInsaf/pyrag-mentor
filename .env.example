# Application
DEBUG=true
PROJECT_NAME=PyRAG Mentor
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Database
DATABASE_URL=sqlite+aiosqlite:///./pyrag_mentor.db
DATABASE_ECHO=false

# LLM: yandexgpt | huggingface
LLM_PROVIDER=yandexgpt
AGENT_ENGINE=auto
FALLBACK_TO_HUGGINGFACE=true
YANDEX_API_KEY=replace_with_your_api_key
YANDEX_FOLDER_ID=replace_with_your_folder_id
YANDEX_GPT_MODEL=yandexgpt/latest
YANDEX_GPT_ENDPOINT=https://ai.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_GPT_TEMPERATURE=0.2
YANDEX_GPT_MAX_TOKENS=2000
HF_TOKEN=replace_with_your_huggingface_token
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Retrieval and services
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=python_docs
RRF_K=60
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Agents
MAX_AGENT_ITERATIONS=3
CRITIC_SUCCESS_SCORE=7.0

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=pyrag-mentor.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

